rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Config: readable/writable by all (presentation sets active ID)
    match /config/{document} {
      allow read, write: if true;
    }

    // Presentations: readable/writable by all (presentation creates/updates)
    match /presentations/{presentationId} {
      allow read, write: if true;

      // Participants: readable by all, create-only (vote app registers), deletable for cleanup
      match /participants/{participantId} {
        allow read: if true;
        allow create, delete: if true;
        allow update: if false;
      }

      // Votes: readable/writable by presentation
      match /votes/{voteId} {
        allow read, write: if true;

        // Ballots: readable by all, create-only (vote app submits), deletable for cleanup
        match /ballots/{participantId} {
          allow read: if true;
          allow create, delete: if true;
          allow update: if false;
        }
      }

      // Polls: readable/writable by presentation
      match /polls/{pollId} {
        allow read, write: if true;

        // Responses: readable by all, create-only (vote app submits), deletable for cleanup
        match /responses/{participantId} {
          allow read: if true;
          allow create, delete: if true;
          allow update: if false;
        }
      }
    }
  }
}
